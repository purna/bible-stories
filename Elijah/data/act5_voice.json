      "items": [
        {
          "id": "voice_7_text",
          "type": "text",
          "sfx": false,
          "text": "Go back. Anoint Hazael king over Aram, Jehu king over Israel, and Elisha to succeed you as prophet. And remember: I have kept seven thousand in Israel who have not bowed to Baal.",
