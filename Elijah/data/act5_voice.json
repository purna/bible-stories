          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "elijah",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
