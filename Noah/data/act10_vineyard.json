        {
          "label": "You are Shem or Japheth — cover without looking 🙈",
          "note": "\"Blessed be the LORD, the God of Shem.\" — Gen 9:26. Dignity over exposure."
        },
        {
          "label": "You are Ham — go and tell 👁️",
          "note": "\"Cursed be Canaan.\" — Gen 9:25. The long shadow of a moment's disrespect."
        }
      ],
      "items": [
        {
          "id": "vineyard_4_text",
          "type": "text",
          "sfx": false,
          "text": "The one righteous man, who built the ark and survived the flood, stumbled here.",
