        {
          "id": "mission_4_text",
          "type": "text",
          "sfx": false,
          "text": "PEOPLE OF NINEVEH! Forty days from now, this city will fall — unless something changes!",
          "speaker": "jonah",
          "align": "center",
          "position": "center",
          "width": "1/2",
          "style": "comic",
          "entryFx": "bounce",
          "delay": 800
