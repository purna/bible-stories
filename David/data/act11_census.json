      "cite": "2 Samuel 24:10",
      "items": [
        {
          "id": "census_2_text",
          "type": "text",
          "sfx": false,
          "text": "I have sinned greatly, for I have walked in folly. Now, I pray Thee, take away the iniquity of Thy servant, for I have done very foolishly.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
