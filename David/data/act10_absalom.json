      "items": [
        {
          "id": "absalom_3_text",
          "type": "text",
          "sfx": false,
          "text": "The rebellion spread through the hill country. David left Jerusalem at night with his household, crossing the Kidron in the dark.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
