          "zIndex": 1
        }
      ]
    },
    {
      "id": "absalom_1",
      "items": [
        {
          "id": "absalom_1_text",
          "type": "text",
          "sfx": false,
          "text": "He stole the hearts of the young men of Israel. When the king's counsel went out from the gate, Absalom stood in his place.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
