          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ]
    },
    {
      "id": "absalom_2",
      "items": [
        {
          "id": "absalom_2_text",
          "type": "text",
          "sfx": false,
          "text": "If I were judge in the land, everyone who has a cause would find justice. The king is far from the people and does not hear them.",
          "position": "middle-right",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "type",
          "exitFx": "fade",
