          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ]
    },
    {
      "id": "absalom_7",
      "items": [
        {
          "id": "absalom_7_text",
          "type": "text",
          "sfx": false,
          "text": "Absalom built his rise on the people's complaints and fell by his own head caught in a tree. The king who had lost a son knew the cost of every crown.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
