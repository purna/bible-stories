      "cite": "2 Samuel 19:4",
      "items": [
        {
          "id": "absalom_6_text",
          "type": "text",
          "sfx": false,
          "text": "The king went into the chamber over the gate and wept. The city mourned, and the throne that had once seemed unshakeable sat under the weight of a father's grief.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
