      "cite": "2 Samuel 18:9",
      "items": [
        {
          "id": "absalom_5_text",
          "type": "text",
          "sfx": false,
          "text": "The battle was fought in the forest of Ephraim. Absalom's head caught in the branches of an oak, and his mule rode away beneath him. He hung there and died.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
