          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ]
    },
    {
      "id": "absalom_4",
      "cite": "2 Samuel 18:33",
      "items": [
        {
          "id": "absalom_4_text",
          "type": "text",
          "sfx": false,
          "text": "O my son Absalom, my son, my son Absalom! Would God I had died for you, O Absalom, my son, my son!",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
