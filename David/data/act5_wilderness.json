        {
          "id": "wilderness_2_text",
          "type": "text",
          "sfx": false,
          "text": "Here I am, the man who has hunted you across the hills. Cut off this corner of my robe — that is all you need.",
          "position": "middle-right",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
