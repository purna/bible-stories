      "items": [
        {
          "id": "redeemed_1_text",
          "type": "text",
          "sfx": false,
          "text": "So the guardian-redeemer said to Boaz, 'Buy it yourself,' and removed his sandal.",
          "position": "center",
          "margin": "M",
