          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_2",
      "cite": "Exodus 5:1",
      "items": [
        {
          "id": "throne_2_text",
          "type": "text",
          "sfx": false,
          "text": "This is what the LORD, the God of Israel, says: \"Let my people go, so that they may hold a festival to me in the wilderness.\"",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "moses",
          "align": "left",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_3",
      "items": [
        {
          "id": "throne_3_text",
          "type": "text",
          "sfx": false,
          "text": "Who is the LORD, that I should obey him and let Israel go? I do not know the LORD, and I will not let Israel go.",
          "position": "middle-right",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "shake",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "pharaoh",
          "align": "right",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_4",
      "items": [
        {
          "id": "throne_4_text",
          "type": "text",
          "sfx": false,
          "text": "That same day Pharaoh gave an order. The Hebrews must gather their own straw — and make the same number of bricks as before.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_5",
      "cite": "Exodus 5:21",
      "items": [
        {
          "id": "throne_5_text",
          "type": "text",
          "sfx": false,
          "text": "You have made us a stench to Pharaoh and his officials. You have put a sword in their hands to kill us.",
          "position": "middle-right",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "israelite_elder",
          "align": "right",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_6",
      "choices": [
        {
          "label": "Go back before Pharaoh 🏛️",
          "note": "The LORD has already said Pharaoh will not listen — and that his mighty hand will drive Israel out."
        },
        {
          "label": "Tell the people to endure 🧱",
          "note": "The bricks keep coming. The cry of the people keeps rising. The call has not gone away."
        }
      ],
      "items": [
        {
          "id": "throne_6_text",
          "type": "text",
          "sfx": false,
          "text": "Moses had spoken for God, and everything had become harder. Whether to go back before Pharaoh was his to decide.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_7",
      "cite": "Exodus 7:10–12",
      "items": [
        {
          "id": "throne_7_text",
          "type": "text",
          "sfx": false,
          "text": "Aaron threw his staff down before Pharaoh, and it became a serpent. Pharaoh's magicians did the same with their secret arts — but Aaron's staff swallowed theirs.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_8",
      "items": [
        {
          "id": "throne_8_text",
          "type": "text",
          "sfx": false,
          "text": "Pharaoh's heart was hard. So the Nile turned to blood, and the fish died, and the river stank.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "shake",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        },
        {
          "id": "throne_8_sfx",
          "type": "sfx",
          "sfx": true,
          "text": "BLOOD!",
          "position": "top-middle",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "sfx-impact",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 2
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_9",
      "items": [
        {
          "id": "throne_9_text",
          "type": "text",
          "sfx": false,
          "text": "Then frogs. Then gnats. Then flies. Each time Pharaoh promised to let them go — and each time the relief came, he hardened his heart again.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_10",
      "cite": "Exodus 8:28",
      "items": [
        {
          "id": "throne_10_text",
          "type": "text",
          "sfx": false,
          "text": "I will let you go to offer sacrifices to the LORD your God in the wilderness, but you must not go very far. Now pray for me.",
          "position": "middle-right",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "pharaoh",
          "align": "right",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_11",
      "cite": "Exodus 10:23",
      "items": [
        {
          "id": "throne_11_text",
          "type": "text",
          "sfx": false,
          "text": "Livestock. Boils. Hail. Locusts. Darkness over all of Egypt — yet where the Israelites lived, there was light.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_12",
      "cite": "Exodus 10:28",
      "items": [
        {
          "id": "throne_12_text",
          "type": "text",
          "sfx": false,
          "text": "Get out of my sight! Make sure you do not appear before me again! The day you see my face you will die.",
          "position": "middle-right",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "shake",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "pharaoh",
          "align": "right",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_13",
      "cite": "Exodus 10:29; 11:4–5",
      "items": [
        {
          "id": "throne_13_text",
          "type": "text",
          "sfx": false,
          "text": "Just as you say. I will never appear before you again. But this is what the LORD says: \"About midnight I will go throughout Egypt. Every firstborn son in the land will die.\"",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "moses",
          "align": "left",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_14",
      "items": [
        {
          "id": "throne_14_text",
          "type": "text",
          "sfx": false,
          "text": "Nine times Moses had come before Pharaoh. Nine times Pharaoh had refused. One night was left.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    }
  ],
