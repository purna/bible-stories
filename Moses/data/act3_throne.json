          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "throne_1",
      "items": [
        {
          "id": "throne_1_text",
          "type": "text",
          "sfx": false,
          "text": "Then Moses and Aaron walked into Pharaoh's court.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
