      "items": [
        {
          "id": "throne_0_text",
          "type": "text",
          "sfx": false,
          "text": "Aaron told the elders of Israel everything the LORD had said to Moses, and performed the signs. The people believed. They bowed down and worshipped.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
