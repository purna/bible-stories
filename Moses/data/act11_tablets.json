      "items": [
        {
          "id": "tablets_5_text",
          "type": "text",
          "sfx": false,
          "text": "When he came down, his face was radiant because he had spoken with the LORD. Aaron and the Israelites were afraid to come near him.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
