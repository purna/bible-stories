      "cite": "Exodus 34:9",
      "items": [
        {
          "id": "tablets_3_text",
          "type": "text",
          "sfx": false,
          "text": "If I have found favour in your eyes, Lord, then let the Lord go with us. Although this is a stiff-necked people, forgive our wickedness and our sin, and take us as your inheritance.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
