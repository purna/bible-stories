      "items": [
        {
          "id": "tablets_6_text",
          "type": "text",
          "sfx": false,
          "text": "So Moses put a veil over his face when he finished speaking to them, and took it off whenever he went in before the LORD.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
