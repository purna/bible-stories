      "items": [
        {
          "id": "tablets_4_text",
          "type": "text",
          "sfx": false,
          "text": "Moses was there with the LORD forty days and forty nights. He wrote on the tablets the words of the covenant — the Ten Commandments.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
