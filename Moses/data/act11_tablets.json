      "items": [
        {
          "id": "tablets_2_text",
          "type": "text",
          "sfx": false,
          "text": "The LORD, the LORD, the compassionate and gracious God, slow to anger, abounding in love and faithfulness, forgiving wickedness, rebellion and sin.",
