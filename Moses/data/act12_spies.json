          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "spies_7",
      "cite": "Numbers 14:7–9",
      "items": [
        {
          "id": "spies_7_text",
          "type": "text",
          "sfx": false,
          "text": "The land we explored is exceedingly good. If the LORD is pleased with us, he will lead us into it. Do not rebel against the LORD. Do not be afraid of the people of the land.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "joshua",
          "align": "left",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "spies_8",
      "items": [
        {
          "id": "spies_8_text",
          "type": "text",
          "sfx": false,
          "text": "But the other spies spoke against Caleb. The whole assembly talked about stoning them.",
