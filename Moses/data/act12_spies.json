      "items": [
        {
          "id": "spies_13_text",
          "type": "text",
          "sfx": false,
          "text": "Moses fell facedown. Then the ground split open beneath Korah's followers and swallowed them.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
