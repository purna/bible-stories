    {
      "id": "spies_10",
      "cite": "Numbers 14:30, 33",
      "items": [
        {
          "id": "spies_10_text",
          "type": "text",
          "sfx": false,
          "text": "Not one of you will enter the land I swore with uplifted hand to make your home. Your children will be wanderers in the wilderness for forty years.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "god",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "spies_11",
      "cite": "Numbers 14:40–45",
      "items": [
        {
          "id": "spies_11_text",
          "type": "text",
          "sfx": false,
          "text": "The next morning some of the people went up toward the hill country anyway — without Moses, without the ark. The Amalekites and Canaanites drove them back.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "shake",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
