      "cite": "Numbers 16:3",
      "items": [
        {
          "id": "spies_12_text",
          "type": "text",
          "sfx": false,
          "text": "You have gone too far! The whole community is holy, every one of them, and the LORD is with them. Why do you set yourselves above the LORD's assembly?",
          "position": "middle-right",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "shake",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "korah",
          "align": "right",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
