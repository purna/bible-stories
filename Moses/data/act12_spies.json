        {
          "id": "spies_5_text",
          "type": "text",
          "sfx": false,
          "text": "We should go up and take possession of the land, for we can certainly do it.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "comic",
