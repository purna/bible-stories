          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "caleb",
          "align": "left",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "spies_6",
      "cite": "Numbers 13:31–33",
      "items": [
        {
          "id": "spies_6_text",
          "type": "text",
          "sfx": false,
          "text": "But the men who had gone with him said, \"We can't attack those people; they are stronger than we are.\" They saw giants, and felt like grasshoppers.",
