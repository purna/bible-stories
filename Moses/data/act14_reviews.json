      "cite": "Deuteronomy 30:19",
      "items": [
        {
          "id": "reviews_6_text",
          "type": "text",
          "sfx": false,
          "text": "I call the heavens and the earth as witnesses against you today: I have set before you life and death, blessings and curses. Now choose life, so that you and your children may live.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
