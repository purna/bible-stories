      "cite": "Deuteronomy 8:2–3",
      "items": [
        {
          "id": "reviews_2_text",
          "type": "text",
          "sfx": false,
          "text": "Remember how the LORD led you all the way in the wilderness these forty years. He fed you with manna to teach you that man does not live on bread alone, but on every word that comes from the mouth of the LORD.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
