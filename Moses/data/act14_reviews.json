    },
    {
      "id": "reviews_3",
      "cite": "Deuteronomy 6:4–5",
      "items": [
        {
          "id": "reviews_3_text",
          "type": "text",
          "sfx": false,
          "text": "Hear, O Israel: The LORD our God, the LORD is one. Love the LORD your God with all your heart and with all your soul and with all your strength.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "comic",
