      "items": [
        {
          "id": "jethro_10_text",
          "type": "text",
          "sfx": false,
          "text": "Then Moses sent his father-in-law on his way, and Jethro returned to his own country.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
