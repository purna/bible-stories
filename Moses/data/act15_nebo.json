          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "nebo_2",
      "items": [
        {
          "id": "nebo_2_text",
          "type": "text",
          "sfx": false,
          "text": "Then Moses commissioned Joshua son of Nun. \"Be strong and courageous, for you must go with this people into the land that the LORD swore to their ancestors to give them.\"",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
