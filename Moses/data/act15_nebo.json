          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "nebo_3",
      "items": [
        {
          "id": "nebo_3_text",
          "type": "text",
          "sfx": false,
          "text": "Moses wrote down the law. He gave it to the priests and to all the elders of Israel. He commanded them: read this law aloud every seven years, at the festival of shelters.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "nebo_4",
      "items": [
        {
          "id": "nebo_4_text",
          "type": "text",
          "sfx": false,
          "text": "I am now a hundred and twenty years old and I am no longer able to lead you. The LORD has said to me, \"You will not cross the Jordan.\"",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "moses",
          "align": "left",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "nebo_5",
      "items": [
        {
          "id": "nebo_5_text",
          "type": "text",
          "sfx": false,
          "text": "Be strong and courageous. Do not be afraid. The LORD your God goes with you. He will never leave you nor forsake you.",
          "position": "middle-left",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "moses",
          "align": "left",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
