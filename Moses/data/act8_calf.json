    {
      "id": "calf_4",
      "cite": "Exodus 32:7–8",
      "items": [
        {
          "id": "calf_4_text",
          "type": "text",
          "sfx": false,
          "text": "Go down, because your people, whom you brought up out of Egypt, have become corrupt. They have been quick to turn away from what I commanded them.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "god",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
      "id": "calf_5",
      "choices": [
        {
          "label": "Plead for the people — every one of them 🙏",
          "note": "Moses offers himself to be blotted out instead. God does not take the offer — but He relents the destruction."
        },
        {
          "label": "Speak for yourself — walk away from this 🚶",
          "note": "Moses has reached the end of what he can carry alone. He turns back to the camp anyway."
        }
      ],
      "items": [
        {
          "id": "calf_5_text",
          "type": "text",
          "sfx": false,
          "text": "O LORD, why have you brought trouble on this people? Turn from your fierce anger. Remember Abraham, Isaac and Israel, your servants.",
