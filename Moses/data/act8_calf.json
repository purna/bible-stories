        {
          "id": "calf_9_text",
          "type": "text",
          "sfx": false,
          "text": "The sons of Levi gathered to him. He said: \"Each man strap a sword to his side. Go back and forth through the camp from one end to the other. Each man kill his brother and friend and neighbour.\"",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
