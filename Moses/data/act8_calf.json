        {
          "id": "calf_11_text",
          "type": "text",
          "sfx": false,
          "text": "Whoever has sinned against me I will blot out of my book. Now go, lead the people to the place I spoke of. My angel will go before you.",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "bounce",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
