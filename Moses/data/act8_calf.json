      "items": [
        {
          "id": "calf_10_text",
          "type": "text",
          "sfx": false,
          "text": "About three thousand people died that day. Then Moses returned to the LORD. \"Please forgive your people. Blot me out of the book you have written if you will not.\"",
          "position": "center",
          "margin": "M",
          "delay": 800,
          "visibleDuration": 0,
          "entryFx": "fade",
          "exitFx": "fade",
          "style": "comic",
          "bold": false,
          "italic": false,
          "rotation": 0,
          "font": "default",
          "fontSize": 0,
          "speaker": "narrator",
          "align": "center",
          "width": "1/2",
          "zIndex": 1
        }
      ],
      "svg": "placeholder"
    },
    {
